#!/bin/bash
set -e

# Parse command line arguments
KERNEL_PATH=""
ROOTFS_PATH=""
MEMORY_MB=""
CPU_COUNT="1"
NO_NETWORK=false

print_usage() {
    cat << EOF
Usage: linux-vm-boot --kernel <path> --rootfs <path> --memory <MB> [--cpus <N>] [--no-network]

Options:
  --kernel <path>    Path to the kernel image (vmlinux)
  --rootfs <path>    Path to the root filesystem image (rootfs.ext4)
  --memory <MB>      Amount of memory in megabytes
  --cpus <N>         Number of CPUs (default: 1)
  --no-network       Disable networking (no TAP device required)
  --help, -h         Show this help message

Example:
  linux-vm-boot --kernel vmlinux --rootfs rootfs.ext4 --memory 128 --cpus 2
EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --kernel)
            KERNEL_PATH="$2"
            shift 2
            ;;
        --rootfs)
            ROOTFS_PATH="$2"
            shift 2
            ;;
        --memory)
            MEMORY_MB="$2"
            shift 2
            ;;
        --cpus)
            CPU_COUNT="$2"
            shift 2
            ;;
        --no-network)
            NO_NETWORK=true
            shift
            ;;
        --help|-h)
            print_usage
            exit 0
            ;;
        *)
            echo "Error: Unknown argument '$1'"
            print_usage
            exit 1
            ;;
    esac
done

# Validate arguments
if [ -z "$KERNEL_PATH" ]; then
    echo "Error: --kernel is required"
    print_usage
    exit 1
fi

if [ -z "$ROOTFS_PATH" ]; then
    echo "Error: --rootfs is required"
    print_usage
    exit 1
fi

if [ -z "$MEMORY_MB" ]; then
    echo "Error: --memory is required"
    print_usage
    exit 1
fi

# Validate files exist
if [ ! -f "$KERNEL_PATH" ]; then
    echo "Error: Kernel file not found: $KERNEL_PATH"
    exit 1
fi

if [ ! -f "$ROOTFS_PATH" ]; then
    echo "Error: Rootfs file not found: $ROOTFS_PATH"
    exit 1
fi

# Validate memory is a positive integer
if ! [[ "$MEMORY_MB" =~ ^[0-9]+$ ]] || [ "$MEMORY_MB" -le 0 ]; then
    echo "Error: Memory must be a positive integer"
    exit 1
fi

# Validate cpus is a positive integer
if ! [[ "$CPU_COUNT" =~ ^[0-9]+$ ]] || [ "$CPU_COUNT" -le 0 ]; then
    echo "Error: CPUs must be a positive integer"
    exit 1
fi

# Check for firecracker (project-local first, then PATH)
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
if [ -x "${SCRIPT_DIR}/bin/firecracker" ]; then
    FIRECRACKER="${SCRIPT_DIR}/bin/firecracker"
elif command -v firecracker &> /dev/null; then
    FIRECRACKER="firecracker"
else
    echo "Error: firecracker not found"
    echo "Run ./setup-debian.sh or install manually from:"
    echo "  https://github.com/firecracker-microvm/firecracker/releases"
    exit 1
fi

# Get absolute paths
KERNEL_PATH=$(realpath "$KERNEL_PATH")
ROOTFS_PATH=$(realpath "$ROOTFS_PATH")

# Create temporary directory for Firecracker files
TEMP_DIR=$(mktemp -d)
trap "rm -rf ${TEMP_DIR}" EXIT

# Create Firecracker configuration
CONFIG_FILE="${TEMP_DIR}/config.json"
SOCKET_PATH="${TEMP_DIR}/firecracker.socket"

# Build network config
if [ "$NO_NETWORK" = true ]; then
    NETWORK_CONFIG=""
else
    NETWORK_CONFIG=',
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "guest_mac": "AA:FC:00:00:00:01",
      "host_dev_name": "tap0"
    }
  ]'
fi

cat > "$CONFIG_FILE" << EOF
{
  "boot-source": {
    "kernel_image_path": "${KERNEL_PATH}",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "${ROOTFS_PATH}",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": ${CPU_COUNT},
    "mem_size_mib": ${MEMORY_MB},
    "smt": false
  }${NETWORK_CONFIG}
}
EOF

echo "Starting VM..."
echo "Kernel: ${KERNEL_PATH}"
echo "Rootfs: ${ROOTFS_PATH}"
echo "Memory: ${MEMORY_MB} MB"
echo "CPUs: ${CPU_COUNT}"
echo "---"

# Run Firecracker
$FIRECRACKER --api-sock "${SOCKET_PATH}" --config-file "${CONFIG_FILE}"

echo "---"
echo "VM stopped"
